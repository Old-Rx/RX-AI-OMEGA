# Development defaults are safe for local use. Copy this file to .env.
RX_ENVIRONMENT=development
RX_DATABASE_URL=sqlite:///./data/rx_ai_omega.db
RX_AUTH_SECRET=change-me-for-any-shared-or-production-deployment
RX_ACCESS_TOKEN_MINUTES=60
RX_BOOTSTRAP_ADMIN_USERNAME=admin
RX_BOOTSTRAP_ADMIN_PASSWORD=change-me-now
RX_PROVIDER=mock
RX_OPENAI_API_KEY=
RX_OPENAI_MODEL=gpt-4.1-mini
RX_OLLAMA_BASE_URL=http://ollama:11434
RX_OLLAMA_MODEL=llama3.2
RX_MEMORY_BACKEND=local
RX_QDRANT_URL=http://qdrant:6333
RX_QDRANT_API_KEY=
RX_EXECUTION_BACKEND=local
RX_REDIS_URL=redis://redis:6379/0
RX_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
RX_LOG_LEVEL=INFO

# Used only by compose.yaml.
POSTGRES_PASSWORD=change-this-database-password
